# Neon Postgres (use the POOLED connection string — host contains "-pooler")
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/cookbook?sslmode=require"

# Cloudflare R2 (S3-compatible image storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cookbook-images
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Hugging Face (AI image generation — optional, currently disabled)
HUGGINGFACE_API_TOKEN=

# App login password
APP_PASSWORD=
